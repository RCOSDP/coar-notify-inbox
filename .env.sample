ENABLE_PUSH_NOTIFICATIONS=True
ICON=
MONGO_DB_URI=mongodb://root:password@localhost:27017
MONGO_DB_NAME=inbox
ON_RECEIVE_NOTIFICATION_WEBHOOK_URL=""
ALLOWED_ADMIN_ORIGINS='["*"]'
ALLOWED_ORIGINS='["*"]'
SUBSCRIBER=mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Empty leaves /subscribe, /unsubscribe and /userprofile open to any caller; set the same value on
# the repository that posts to them.
SUBSCRIPTION_TOKEN_SECRET=
# The name of the current key, carried in the token's kid header. Only needed to rotate.
SUBSCRIPTION_TOKEN_KEY_ID=
# Keys on their way out, {"kid": "secret"}. Accepted for verification, never used to sign.
SUBSCRIPTION_TOKEN_PREVIOUS_SECRETS='{}'
# When set, a token's iss and aud must match. An empty one is not checked.
SUBSCRIPTION_TOKEN_ISSUER=
SUBSCRIPTION_TOKEN_AUDIENCE=
